# ─────────────────────────────────────────────
# Watch Party — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────

# ── DATABASE (Supabase) ───────────────────────
# Find these in: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Transaction" pooler URL for DATABASE_URL (connection pooling for serverless)
# Use the "Session" direct URL for DIRECT_URL (required by Prisma migrations)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── NEXTAUTH ──────────────────────────────────
# Generate a secret: run `openssl rand -base64 32` in your terminal
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Production URL (change to your actual domain on deploy)
NEXTAUTH_URL="http://localhost:3000"

# ── GOOGLE OAUTH ──────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── SUPABASE STORAGE ──────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ── LIVEKIT (Voice Chat) ──────────────────────
# Sign up at: https://livekit.io — free tier available
# Find these in: LiveKit Cloud Dashboard → Project → Keys
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# ── STRIPE (Payments) ─────────────────────────
# Find these in: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"

# Webhook secret — generated when you create a webhook endpoint in Stripe dashboard
# Endpoint: https://your-domain.com/api/subscriptions/webhook
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# Stripe Price IDs — create these in Stripe dashboard under Products
STRIPE_PREMIUM_PRICE_ID="price_your-premium-monthly-price-id"

# ── YOUTUBE (Video Metadata) ──────────────────
# Create an API key at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Used for fetching video titles, thumbnails, and duration when adding to queue
YOUTUBE_API_KEY="your-youtube-data-api-v3-key"

# ── APP URL ───────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── SOCKET SERVER ─────────────────────────────
# URL of the custom Express + Socket.io server (separate from Next.js in production)
# In development this runs on the same machine on a different port
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
